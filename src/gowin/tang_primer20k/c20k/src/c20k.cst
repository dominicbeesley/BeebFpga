//Locations suitable for 20K primer in ext dock board

// System Clock (27MHz)
IO_LOC  "sys_clk" H11;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Button 1 - C20K - reset button at back left
IO_LOC  "btn1_n" T6;	
IO_PORT "btn1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// Keyboard - C20L - bodge onto i2c connector for now...
IO_LOC  "ps2_clk" P15;
IO_PORT "ps2_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "ps2_data" P16;
IO_PORT "ps2_data" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// // Mouse - PMOD1
// IO_LOC  "ps2_mouse_clk" T12;
// IO_PORT "ps2_mouse_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// IO_LOC  "ps2_mouse_data" R11;
// IO_PORT "ps2_mouse_data" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// VGA 
IO_LOC "vid_chr_o" E9;
IO_PORT "vid_chr_o" IO_TYPE=LVCMOS15 PULL_MODE=NONE;

IO_LOC "vid_r_o" D7;
IO_PORT "vid_r_o" IO_TYPE=LVCMOS15 PULL_MODE=NONE;

IO_LOC "vid_g_o" C7;
IO_PORT "vid_g_o" IO_TYPE=LVCMOS15 PULL_MODE=NONE;

IO_LOC "vid_b_o" E8;
IO_PORT "vid_b_o" IO_TYPE=LVCMOS15 PULL_MODE=NONE;

// C20K BODGE - DTR!
IO_LOC "vid_cs_o" E16;
IO_PORT "vid_cs_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24;





// SD Card
IO_LOC  "tf_cs" N11;
IO_PORT "tf_cs" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "tf_mosi" R14;
IO_PORT "tf_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "tf_sclk" N10;
IO_PORT "tf_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "tf_miso" M8;
IO_PORT "tf_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// UART
IO_LOC  "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC  "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// SPI Flash
IO_LOC  "flash_cs" M9;
IO_PORT "flash_cs" IO_TYPE=LVCMOS33;
IO_LOC  "flash_ck" L10;
IO_PORT "flash_ck" IO_TYPE=LVCMOS33;
IO_LOC  "flash_si" R10;
IO_PORT "flash_si" IO_TYPE=LVCMOS33;
IO_LOC  "flash_so" P10;
IO_PORT "flash_so" IO_TYPE=LVCMOS33 PULL_MODE=UP;



// 1BIT DAC AUDIO

IO_LOC	"audior_o"	P7;
IO_PORT	"audior_o"	IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC	"audiol_o"	L8;
IO_PORT	"audiol_o"	IO_TYPE=LVCMOS33 PULL_MODE=NONE;


